MONGO_URI=mongodb://localhost:27017/campuskart
JWT_SECRET=change_this_to_a_long_random_secret
PORT=5000
NODE_ENV=development

# ── SMS OTP (Twilio Verify) ──────────────────────────────────────────────────
# Leave these as placeholders to use DEV BYPASS MODE (OTP printed to console).
# Fill in real values from https://console.twilio.com when going to production.
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_VERIFY_SERVICE_SID=your_verify_service_sid

# ── Email (Resend API) ────────────────────────────────────────────────────────
# Optional: only needed if email OTP features are used.
# Get key from https://resend.com
# RESEND_API_KEY=re_your_key_here
# EMAIL_FROM=KEMP <noreply@yourdomain.com>

# ── Listing Image Moderation ───────────────────────────────────────────────────
# Human/person detection runs locally (TensorFlow.js + COCO-SSD, see
# backend/src/services/imageModeration/localPersonDetector.js) — needs no
# API key and works the same in dev and production. Confidence threshold:
PERSON_CONFIDENCE_THRESHOLD=0.5

# ── Web Push (browser push notifications) ──────────────────────────────────
# Generate a real keypair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Every existing Notification (order updates, blood requests, warranty
# reminders, announcements, chat, community) is delivered as a push
# notification automatically once these are set — no per-feature wiring
# needed. Leave unset to disable push (in-app notifications still work).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@kemp.local

# Unwanted-content categories (nudity/weapon/drugs/gore/offensive) are
# separate from human detection and still go through Sightengine. Leave
# these as placeholders to use DEV BYPASS MODE for just that part (mock
# moderation, see providers/mockProvider.js). In production these MUST be
# set to real values or uploads will be rejected (fail-safe).
# Free API key from https://sightengine.com
IMAGE_MODERATION_PROVIDER=sightengine
SIGHTENGINE_API_USER=your_api_user
SIGHTENGINE_API_SECRET=your_api_secret
